# Template for .env — copy it to .env and fill in real values:
#   cp .env.example .env
# .env is read by docker-compose.yml (env_file) and by app.py on a local run.

# Signs session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it later signs every player and the DM out.
MORKBORG_SECRET_KEY=

# Shared DM password.
MORKBORG_DM_PASSWORD=

# The host user the container runs as (docker-compose.yml `user:`). Must own
# the ./data folder. Find yours on the Pi with `id -u` and `id -g`.
PUID=1000
PGID=1000

# Timezone for Activity Log timestamps.
TZ=America/New_York

# Optional: set to 1 only when a reverse proxy (Caddy, nginx) sits in front,
# so per-IP login limits see players' real addresses.
# MORKBORG_BEHIND_PROXY=1
